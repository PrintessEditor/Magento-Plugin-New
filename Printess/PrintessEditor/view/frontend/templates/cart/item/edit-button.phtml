<?php
/** @var \Printess\PrintessEditor\Block\Cart\EditButton $block */
if (!$block->isPrintessItem()) {
    return;
}

$itemData = $block->getItemData();
$uid      = uniqid('pe_');
?>

<a class="action printess-cart-edit"
   id="printess-edit-<?= /* @noEscape */ $uid ?>"
   href="#"
   title="<?= $escaper->escapeHtmlAttr(__('Customize')) ?>">
    <?= $escaper->escapeHtml(__('Customize')) ?>
</a>

<script>
require(['Printess_PrintessEditor/js/printess-integration'], function (PrintessEditor) {
    document.getElementById('printess-edit-<?= /* @noEscape */ $uid ?>').addEventListener('click', function (e) {
        e.preventDefault();
        PrintessEditor.openFromCart({
            shopToken:           <?= /* @noEscape */ json_encode($itemData['shopToken']) ?>,
            panelLoaderUrl:      <?= /* @noEscape */ json_encode($itemData['panelLoaderUrl']) ?>,
            saveToken:           <?= /* @noEscape */ json_encode($itemData['saveToken']) ?>,
            itemId:              <?= /* @noEscape */ (int)$itemData['itemId'] ?>,
            basePrice:           <?= /* @noEscape */ (float)$itemData['basePrice'] ?>,
            pagePricing:         <?= /* @noEscape */ json_encode($itemData['pagePricing']) ?>,
            currencyCode:        <?= /* @noEscape */ json_encode($itemData['currencyCode']) ?>,
            locale:              <?= /* @noEscape */ json_encode($itemData['locale']) ?>,
            minPages:            <?= /* @noEscape */ (int)$itemData['minPages'] ?>,
            formFields:          <?= /* @noEscape */ json_encode($itemData['formFields']) ?>,
            customOptions:       <?= /* @noEscape */ json_encode($itemData['customOptions']) ?>,
            theme:               <?= /* @noEscape */ json_encode($itemData['theme']) ?>,
            magicPhotobookTheme: <?= /* @noEscape */ json_encode($itemData['magicPhotobookTheme']) ?>,
            printSettings:       <?= /* @noEscape */ json_encode($itemData['printSettings']) ?>,
            updateUrl:           '<?= $escaper->escapeUrl($block->getUrl('printess/cart/update')) ?>',
            saveUrl:             <?= /* @noEscape */ json_encode($itemData['saveUrl']) ?>,
            projectId:           <?= /* @noEscape */ (int)$itemData['projectId'] ?>,
            productId:           <?= /* @noEscape */ (int)$itemData['productId'] ?>,
            formKey:             window.FORM_KEY || document.querySelector('[name="form_key"]')?.value || ''
        });
    });
});
</script>
