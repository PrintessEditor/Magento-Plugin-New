// Shows the copy fields only while "duplicate" is chosen and keeps exactly one submit button enabled, so Enter or a
// stray click can never send the other action. Bound via a script (no inline handlers) for the admin CSP.
$script = <<<JS
(function () {
    var choice = document.querySelector('.printess-batch-choice');
    if (!choice) {
        return;
    }
    var form = choice.closest('form');
    var fields = choice.querySelector('.printess-batch-copy-fields');
    var copyButton = choice.querySelector('.printess-batch-copy-button');
    function update() {
        var checked = choice.querySelector('input[name="reproduction_choice"]:checked');
        var copy = !!checked && checked.value === 'copy';
        // style.display rather than [hidden]: admin button styles set their own display value.
        fields.style.display = copy ? '' : 'none';
        copyButton.disabled = !copy;
        // Looked up on every call: this script runs inside the form, before the page's own resend button exists.
        var resendButtons = form ? form.querySelectorAll('.printess-batch-resend-button') : [];
        resendButtons.forEach(function (button) {
            button.style.display = copy ? 'none' : '';
            button.disabled = copy;
        });
    }
    choice.querySelectorAll('input[name="reproduction_choice"]').forEach(function (radio) {
        radio.addEventListener('change', update);
    });
    if (form && copyButton) {
        copyButton.addEventListener('click', function (event) {
            if (!form.querySelector('input[name="copy_items[]"]:checked')) {
                event.preventDefault();
                window.alert(copyButton.getAttribute('data-printess-empty'));
            }
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', update);
    } else {
        update();
    }
})();
JS;
?>
<?php if (isset($secureRenderer)): ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
<?php else: ?>
    <script><?= /* @noEscape */ $script ?></script>
<?php endif; ?>
