<?php
// Plain window.confirm() before each action (no modal widget). Bound via a script instead of inline onsubmit
// attributes so the page also works under a strict admin CSP; the button is disabled after confirming to
// prevent a double submission (a second /order/retry would create a second Printess order).
$script = <<<JS
document.querySelectorAll('.printess-production-actions form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
        var message = form.getAttribute('data-printess-confirm');
        if (message && !window.confirm(message)) {
            event.preventDefault();
            return;
        }
        if (form.getAttribute('data-printess-submitted')) {
            event.preventDefault();
            return;
        }
        form.setAttribute('data-printess-submitted', '1');
        form.querySelectorAll('button').forEach(function (button) { button.disabled = true; });
    });
});
JS;
?>
<?php if (isset($secureRenderer)): ?>
    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
<?php else: ?>
    <script><?= /* @noEscape */ $script ?></script>
<?php endif; ?>
