    <body>
        <referenceBlock name="sales_order_tabs">
            <block class="Printess\PrintessEditor\Block\Adminhtml\Order\View\Tab\Production"
                   name="printess_order_production_tab"
                   template="Printess_PrintessEditor::order/production.phtml"/>
