<?xml version="1.0" encoding="UTF-8"?>
<!-- Pure unit tests (no Magento). Run from the module root:
     phpunit -c Test/Unit/phpunit.xml.dist -->
<phpunit bootstrap="bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Printess Unit">
            <directory suffix="Test.php">.</directory>
        </testsuite>
    </testsuites>
</phpunit>
