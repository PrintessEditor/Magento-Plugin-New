<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="printess_projects" resource="default" engine="innodb" comment="Printess Customer Projects">
        <column xsi:type="int" name="project_id" unsigned="true" nullable="false" identity="true" comment="Project ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="64" comment="Product SKU"/>
        <column xsi:type="varchar" name="product_name" nullable="true" length="255" comment="Product Name"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Project Name"/>
        <column xsi:type="varchar" name="save_token" nullable="false" length="512" comment="Printess Save Token"/>
        <column xsi:type="text" name="thumbnail_url" nullable="true" comment="Printess Thumbnail URL"/>
        <column xsi:type="timestamp" name="expires_at" nullable="true" on_update="false" comment="Expires At"/>
        <column xsi:type="timestamp" name="order_reminder_sent_at" nullable="true" on_update="false" comment="Order Reminder Sent At"/>
        <column xsi:type="timestamp" name="removal_reminder_sent_at" nullable="true" on_update="false" comment="Removal Reminder Sent At"/>
        <column xsi:type="timestamp" name="ordered_at" nullable="true" on_update="false" comment="Ordered At"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Last Printess Save At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="project_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PRINTESS_PROJECT_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="printess_projects" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="PRINTESS_PROJECT_STORE_ID_STORE_STORE_ID"
                    table="printess_projects" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="PRINTESS_PROJECT_CUSTOMER_ID_UPDATED_AT" indexType="btree">
            <column name="customer_id"/>
            <column name="updated_at"/>
        </index>
        <index referenceId="PRINTESS_PROJECT_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
        <index referenceId="PRINTESS_PROJECT_SAVE_TOKEN" indexType="btree">
            <column name="save_token"/>
        </index>
    </table>

    <table name="printess_pdf_jobs" resource="default" engine="innodb" comment="Printess Async PDF Production Jobs">
        <column xsi:type="int" name="job_id" unsigned="true" nullable="false" identity="true" comment="Job ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Sales Order entity_id"/>
        <column xsi:type="int" name="order_item_id" unsigned="true" nullable="false" comment="Sales Order Item item_id"/>
        <column xsi:type="varchar" name="save_token" nullable="false" length="512" comment="Printess Save Token"/>
        <column xsi:type="varchar" name="printess_job_id" nullable="true" length="255" comment="Printess Production Job ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending" comment="Status: awaiting_payment|awaiting_approval|pending|submitting|producing|rendered|shipped|complete|failed"/>
        <column xsi:type="varchar" name="pdf_path" nullable="true" length="512" comment="Saved PDF path relative to var/"/>
        <column xsi:type="smallint" name="fail_count" unsigned="true" nullable="false" default="0" comment="Consecutive failure count"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Store ID (snapshot)"/>
        <column xsi:type="varchar" name="production_type" nullable="false" length="16" default="print" comment="Production type: print|dropship"/>
        <column xsi:type="int" name="copies" unsigned="true" nullable="false" default="1" comment="Copies (qty ordered)"/>
        <column xsi:type="varchar" name="print_settings" nullable="true" length="255" comment="Print settings template (snapshot)"/>
        <column xsi:type="varchar" name="callback_mode" nullable="false" length="16" default="poll" comment="Callback mode: callback|poll (snapshot)"/>
        <column xsi:type="varchar" name="nonce" nullable="true" length="64" comment="Per-job callback nonce"/>
        <column xsi:type="int" name="product_definition_id" unsigned="false" nullable="true" comment="Printess product definition ID (0 = from template)"/>
        <column xsi:type="bigint" name="dropship_data_id" unsigned="true" nullable="true" comment="Printess dropship address ID"/>
        <column xsi:type="varchar" name="linked_order_id" nullable="true" length="64" comment="Linked order GUID shared per order"/>
        <column xsi:type="varchar" name="printess_order_id" nullable="true" length="255" comment="Printess Order ID"/>
        <column xsi:type="timestamp" name="submitted_at" nullable="true" on_update="false" comment="Submitted At"/>
        <column xsi:type="int" name="dropship_state" nullable="true" comment="Dropship partner state"/>
        <column xsi:type="varchar" name="tracking_id" nullable="true" length="255" comment="Tracking ID"/>
        <column xsi:type="text" name="tracking_url" nullable="true" comment="Tracking URL"/>
        <column xsi:type="varchar" name="tracking_type" nullable="true" length="64" comment="Tracking carrier type"/>
        <column xsi:type="timestamp" name="shipped_at" nullable="true" on_update="false" comment="Shipped At"/>
        <column xsi:type="int" name="magento_shipment_id" unsigned="true" nullable="true" comment="Magento Shipment entity_id"/>
        <column xsi:type="mediumtext" name="result_json" nullable="true" comment="Last Printess result payload (JSON)"/>
        <column xsi:type="varchar" name="error_code" nullable="true" length="32" comment="Error code"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Error message"/>
        <column xsi:type="mediumtext" name="history_json" nullable="true" comment="Status history (JSON list)"/>
        <column xsi:type="int" name="dropship_send_count" unsigned="true" nullable="false" default="0" comment="How often the dropship group of this item was sent (1 = first send)"/>
        <column xsi:type="varchar" name="dropship_shop_order_id" nullable="true" length="64" comment="Order number sent to the dropshipper (data.shopOrderId), e.g. 000000123-R1"/>
        <column xsi:type="mediumtext" name="tracking_json" nullable="true" comment="All shipments reported for this item (JSON list of trackingId/trackingUrl/shippedAt/send)"/>
        <column xsi:type="smallint" name="callback_type" unsigned="true" nullable="true" comment="Printess dropship callbackType used for the current send (0, 1 legacy, 3)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="job_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PRINTESS_PDF_JOBS_NONCE">
            <column name="nonce"/>
        </constraint>
        <index referenceId="PRINTESS_PDF_JOBS_LINKED_ORDER_ID" indexType="btree">
            <column name="linked_order_id"/>
        </index>
        <index referenceId="PRINTESS_PDF_JOBS_PRINTESS_ORDER_ID" indexType="btree">
            <column name="printess_order_id"/>
        </index>
        <index referenceId="PRINTESS_PDF_JOBS_PRODUCTION_TYPE_STATUS" indexType="btree">
            <column name="production_type"/>
            <column name="status"/>
        </index>
        <index referenceId="PRINTESS_PDF_JOBS_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="PRINTESS_PDF_JOBS_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="PRINTESS_PDF_JOBS_ORDER_ITEM_ID" indexType="btree">
            <column name="order_item_id"/>
        </index>
    </table>
    <table name="sales_order" resource="sales" comment="Sales Flat Order">
        <column xsi:type="text" name="printess_reproduction_of" nullable="true" comment="Printess: JSON describing the order this order reproduces"/>
        <column xsi:type="text" name="printess_reproduced_as" nullable="true" comment="Printess: JSON list of orders that reproduce this order"/>
    </table>
    <table name="quote" resource="checkout" comment="Sales Flat Quote">
        <column xsi:type="int" name="printess_reproduction_of" unsigned="true" nullable="true" comment="Printess: id of the order this quote reproduces"/>
    </table>
</schema>
