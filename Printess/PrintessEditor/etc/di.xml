<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\CatalogWidget\Block\Product\ProductsList">
        <plugin name="printess_products_list_template"
                type="Printess\PrintessEditor\Plugin\Block\Widget\ProductsListPlugin"/>
    </type>
    <type name="Magento\Catalog\Helper\Product\Configuration">
        <plugin name="printess_hide_internal_options"
                type="Printess\PrintessEditor\Plugin\Helper\ProductConfigurationPlugin"/>
    </type>
    <!--
        Order emails and the customer account order-view page read order item options via
        these two blocks directly (Order\Item::getProductOptions()['additional_options']),
        bypassing Magento\Catalog\Helper\Product\Configuration entirely — so the cart-only
        ProductConfigurationPlugin above never filters them. Without this, every
        Printess-internal key (save token, project id, thumbnail, base price, included
        pages) is shown verbatim to the customer in the order confirmation email and order
        view. Admin order view intentionally keeps full visibility for support purposes.

        Registered globally (not etc/frontend/di.xml): order emails can be rendered outside
        the frontend area (e.g. via the sales_send_order_emails cron, or when resent from
        admin), so an area-scoped plugin would silently not apply in those cases.
    -->
    <type name="Magento\Sales\Block\Order\Email\Items\Order\DefaultOrder">
        <plugin name="printess_hide_internal_options_email"
                type="Printess\PrintessEditor\Plugin\Sales\OrderItemOptionsPlugin"/>
    </type>
    <type name="Magento\Sales\Block\Order\Item\Renderer\DefaultRenderer">
        <plugin name="printess_hide_internal_options_order_view"
                type="Printess\PrintessEditor\Plugin\Sales\OrderItemOptionsPlugin"/>
    </type>
    <!--
        Invoice, shipment and credit-memo confirmation emails render their line items
        through Email\Items\DefaultItems (not DefaultOrder, which it does not extend), so
        the plugin above does not reach them. Without this registration the same
        Printess-internal keys leak into those transactional emails. The plugin filters by
        the "printess_" key prefix only, so it strips nothing else and composes safely with
        Affinity\ProductCustomOptionHidden's plugin already on this block.
    -->
    <type name="Magento\Sales\Block\Order\Email\Items\DefaultItems">
        <plugin name="printess_hide_internal_options_email_docs"
                type="Printess\PrintessEditor\Plugin\Sales\OrderItemOptionsPlugin"/>
    </type>

    <!-- PMD-21 order copy: all of these only act while ReproductionContext is active (see that class). -->
    <type name="Magento\Tax\Model\Config">
        <plugin name="printess_reproduction_tax_after_discount"
                type="Printess\PrintessEditor\Plugin\Tax\ForceTaxAfterDiscount"/>
    </type>
    <type name="Magento\Payment\Model\Method\Free">
        <plugin name="printess_reproduction_allow_free"
                type="Printess\PrintessEditor\Plugin\Payment\AllowFreeForReproduction"/>
    </type>
    <type name="Magento\Quote\Model\Quote">
        <plugin name="printess_reproduction_skip_minimum_amount"
                type="Printess\PrintessEditor\Plugin\Quote\SkipMinimumAmountForReproduction"/>
        <!-- PMD-23: copies the Printess design onto reordered items; only acts while ReorderContext is active. -->
        <plugin name="printess_add_design_on_reorder"
                type="Printess\PrintessEditor\Plugin\Quote\AddPrintessDesignOnReorder"/>
    </type>
    <!-- PMD-23: the Quote::addProduct plugin is built on every add-to-cart; keep it light. -->
    <type name="Printess\PrintessEditor\Plugin\Quote\AddPrintessDesignOnReorder">
        <arguments>
            <argument name="copier" xsi:type="object">Printess\PrintessEditor\Model\Cart\PrintessOptionsCopier\Proxy</argument>
        </arguments>
    </type>
    <type name="Printess\PrintessEditor\Model\Cart\PrintessOptionsCopier">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <!-- PMD-23: native storefront/GraphQL reorder never fires checkout_cart_product_add_after. Global scope so the
         GraphQL reorderItems mutation is covered too. -->
    <type name="Magento\Sales\Model\Reorder\Reorder">
        <plugin name="printess_keep_design_on_reorder"
                type="Printess\PrintessEditor\Plugin\Sales\KeepPrintessDesignOnReorder"/>
    </type>
</config>
