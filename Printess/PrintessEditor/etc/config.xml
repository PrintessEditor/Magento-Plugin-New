<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <printess_designer>
            <production>
                <hold_until_payment>0</hold_until_payment>
                <approve_before_production>0</approve_before_production>
                <callback_mode>callbacks</callback_mode>
                <send_shipment_email>1</send_shipment_email>
                <dropship_reproduction_mode>suffix</dropship_reproduction_mode>
            </production>
            <projects>
                <enabled>0</enabled>
                <retention_days>30</retention_days>
                <order_reminder_after_days>5</order_reminder_after_days>
                <removal_reminder_before_days>5</removal_reminder_before_days>
                <email_batch_limit>100</email_batch_limit>
                <order_reminder_template>printess_designer_projects_order_reminder_template</order_reminder_template>
                <removal_reminder_template>printess_designer_projects_removal_reminder_template</removal_reminder_template>
            </projects>
            <supervisor_approval>
                <enabled>0</enabled>
                <supervisors_need_approval>0</supervisors_need_approval>
                <edit_lock_minutes>60</edit_lock_minutes>
                <notify_on_retract>1</notify_on_retract>
                <email_identity>general</email_identity>
                <template_submitted>printess_designer_supervisor_approval_template_submitted</template_submitted>
                <template_changes_requested>printess_designer_supervisor_approval_template_changes_requested</template_changes_requested>
                <template_supervisor_changed>printess_designer_supervisor_approval_template_supervisor_changed</template_supervisor_changed>
                <template_approved>printess_designer_supervisor_approval_template_approved</template_approved>
                <template_accepted>printess_designer_supervisor_approval_template_accepted</template_accepted>
                <template_replied>printess_designer_supervisor_approval_template_replied</template_replied>
                <template_retracted>printess_designer_supervisor_approval_template_retracted</template_retracted>
                <template_comment>printess_designer_supervisor_approval_template_comment</template_comment>
            </supervisor_approval>
            <cron>
                <send_project_reminders>30 8 * * *</send_project_reminders>
                <remove_expired_projects>30 2 * * *</remove_expired_projects>
            </cron>
        </printess_designer>
        <carriers>
            <!-- PMD-21: hidden carrier for order copies; rates only while an order copy is being built. -->
            <printess_reproduction>
                <active>1</active>
                <model>Printess\PrintessEditor\Model\Carrier\Reproduction</model>
                <title>Reproduction (free)</title>
                <name>Reproduction (free)</name>
                <sallowspecific>0</sallowspecific>
                <showmethod>0</showmethod>
                <sort_order>9999</sort_order>
            </printess_reproduction>
        </carriers>
    </default>
</config>
