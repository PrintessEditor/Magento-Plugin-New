<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_product_add_after">
        <observer name="printess_save_token_to_cart" instance="Printess\PrintessEditor\Observer\SaveTokenToCart"/>
    </event>
    <!-- PMD-23: admin Reorder/Edit copies additional_options natively but drops the Printess page surcharge. -->
    <event name="sales_convert_order_item_to_quote_item">
        <observer name="printess_admin_reorder_page_pricing"
                  instance="Printess\PrintessEditor\Observer\ApplyPagePricingOnAdminReorder"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="printess_transfer_to_order" instance="Printess\PrintessEditor\Observer\TransferToOrder"/>
        <!-- PMD-21: link JSON + original shipping code on an order copy, no new-order e-mail. No-op otherwise. -->
        <observer name="printess_prepare_reproduction_order"
                  instance="Printess\PrintessEditor\Observer\PrepareReproductionOrder"/>
    </event>
    <!-- D9: multishipping never dispatches sales_model_service_quote_submit_before; this fires once per order
         (data: order, address, quote) before it is placed. Order items carry the quote item id, so the same
         transfer applies. Without it multishipping orders lose the design and get no production job. -->
    <event name="checkout_type_multishipping_create_orders_single">
        <observer name="printess_transfer_to_order_multishipping"
                  instance="Printess\PrintessEditor\Observer\TransferToOrder"/>
    </event>
    <event name="sales_order_place_after">
        <!--
            printess_produce_pdf is preserved for reference but intentionally disabled.
            PDF production is handled asynchronously by Cron\ProducePdf via the printess_pdf_jobs
            queue, which is populated by printess_enqueue_pdf_jobs on
            sales_model_service_quote_submit_success (see below).
            Re-enabling this observer would block checkout for up to 120 seconds per item.
        -->
        <!--<observer name="printess_produce_pdf" instance="Printess\PrintessEditor\Observer\ProducePdf"/>-->
        <observer name="printess_mark_saved_project_ordered"
                  instance="Printess\PrintessEditor\Observer\MarkSavedProjectOrdered"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <!--
            Enqueue runs here, not on sales_order_place_after: that event is dispatched inside
            Order::place() BEFORE the order is saved, so order and item ids are still null.
            quote_submit_success fires after the order is saved, for storefront and admin orders.
        -->
        <observer name="printess_enqueue_pdf_jobs" instance="Printess\PrintessEditor\Observer\EnqueuePdfJobs"/>
    </event>
    <event name="checkout_submit_all_after">
        <!--
            Multishipping checkout never dispatches sales_model_service_quote_submit_success; this
            event ('orders' for multishipping, 'order' for onepage) covers it. Onepage orders reach
            the observer twice; EnqueuePdfJobs skips items that already have jobs.
        -->
        <observer name="printess_enqueue_pdf_jobs_submit_all" instance="Printess\PrintessEditor\Observer\EnqueuePdfJobs"/>
    </event>
    <!--
        PMD-21: order copies created with "Reduce stock" off. Cancelling them or refunding with "Return to Stock"
        would give back stock the copy never took; these take it away again (no-op for every other order).
    -->
    <event name="order_cancel_after">
        <observer name="printess_reproduction_cancel_stock"
                  instance="Printess\PrintessEditor\Observer\CompensateReproductionCancel"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="printess_reproduction_refund_stock"
                  instance="Printess\PrintessEditor\Observer\CompensateReproductionRefund"/>
    </event>
</config>
