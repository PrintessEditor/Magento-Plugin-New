<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <section name="quote">
        <group name="totals">
            <!--
                PMD-21 order copy: after SalesRule discount (300) / shipping_discount (400), which would reset it, and
                before tax (450), which reads the item discounts. Inactive unless an order copy is being built.
            -->
            <item name="printess_reproduction" instance="Printess\PrintessEditor\Model\Quote\Total\Reproduction" sort_order="420"/>
        </group>
    </section>
</config>
